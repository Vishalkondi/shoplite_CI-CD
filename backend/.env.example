# Only needed when running the backend WITHOUT Docker (npm run dev).
# Copy to backend/.env and load it with:  node --env-file=.env src/server.js
# (npm run dev:env does this for you.)

PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Points at the Docker Compose database (host port 5433).
DB_HOST=localhost
DB_PORT=5433
DB_USER=shop
DB_PASSWORD=change_me_to_a_local_password
DB_NAME=shop

# Optional: destructive DB tests. The database name MUST end in _test.
# TEST_DATABASE_URL=postgres://shop:change_me_to_a_local_password@localhost:5433/shop_test
